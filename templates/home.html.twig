{% extends 'base.html.twig' %}

{% block content %}
    <div class="sol-terminal sol-mb-lg">
        <span class="sol-prompt">blog view recent_posts</span>
    </div>

    {% if posts is empty %}
        <div class="sol-terminal">
            <span class="sol-prompt">echo "Постів поки немає"</span>
        </div>
    {% else %}
        {% for post in posts %}
            <article class="sol-card sol-card--interactive">
                <div class="sol-card__header">
                    <a href="{{ path('app_post_show', {slug: post.slug}) }}">
                        {{ post.title }}
                    </a>
                </div>
                <div class="sol-card__body">
                    <p>{{ post.content|markdown_to_html|striptags|slice(0, 200) ~ '...' }}</p>
                </div>
                <div class="sol-card__footer text-sm text-muted">
                    <span>{{ post.createdAt|date('d.m.Y') }}</span> |
                    <span>categories: 
                        {% for cat in post.categories %}
                            <a href="{{ path('app_post_index', {category: cat.name}) }}">{{ cat.name }}</a>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </span>
                </div>
            </article>
        {% endfor %}
    {% endif %}

    {% if show_all_posts_link %}
        <div class="sol-text-center sol-mt-lg">
            <a href="{{ path('app_post_index') }}" class="sol-btn sol-btn--primary sol-btn--outline">Переглянути всі дописи</a>
        </div>
    {% endif %}
{% endblock %}
