{% extends 'base.html.twig' %}

{% block content %}
    <form class="sol-form-group sol-flex sol-flex--start sol-mb-lg" method="get" action="{{ path('app_post_index') }}">
        <input type="text" name="search" id="search" placeholder="Пошук постів..." value="{{ search_query }}" class="sol-input">
        <button type="submit" class="sol-btn sol-btn--primary">Пошук</button>
    </form>

    <div class="sol-terminal sol-mb-lg">
        <span class="sol-prompt">blog {{ command_display }}</span>
    </div>

    {% if categories is not empty %}
        <div class="sol-surface sol-mb-lg sol-surface--inline-content">
            <span class="text-accent text-bold">Categories:</span>
            {% for cat in categories %}
                <a href="{{ path('app_post_index', {category: cat}) }}" class="{{ category_filter == cat ? 'category-link--active' : '' }}">{{ cat }}</a>{% if not loop.last %}, {% endif %}
            {% endfor %}
            {% if category_filter %}
                <a href="{{ path('app_post_index') }}" class="text-muted">(Clear)</a>
            {% endif %}
        </div>
    {% endif %}

    {% if posts is empty %}
        <div class="sol-terminal">
            <span class="sol-prompt">echo "Постів не знайдено"</span>
        </div>
    {% else %}
        {% for post in posts %}
            <article class="sol-card sol-card--interactive">
                <div class="sol-card__header">
                    <a href="{{ path('app_post_show', {slug: post.slug}) }}">
                        {{ post.title }}
                    </a>
                </div>
                <div class="sol-card__body">
                    <p>{{ post.content|markdown_to_html|striptags|slice(0, 200) ~ '...' }}</p>
                </div>
                <div class="sol-card__footer text-sm text-muted">
                    <span>{{ post.createdAt|date('d.m.Y') }}</span> |
                    <span>category: <a href="{{ path('app_post_index', {category: post.category}) }}">{{ post.category }}</a></span>
                </div>
            </article>
        {% endfor %}

        {% if total_pages > 1 %}
            <nav aria-label="Post navigation">
                <ul class="sol-pagination">
                    <li class="sol-pagination__item">
                        {% if current_page > 1 %}
                            <a href="{{ path('app_post_index', app.request.query.all|merge({'page': current_page - 1})) }}" class="sol-pagination__link">Previous</a>
                        {% else %}
                            <span class="sol-pagination__link sol-pagination__link--disabled">Previous</span>
                        {% endif %}
                    </li>

                    {% for page in 1..total_pages %}
                        <li class="sol-pagination__item">
                            <a href="{{ path('app_post_index', app.request.query.all|merge({'page': page})) }}" class="sol-pagination__link {{ page == current_page ? 'sol-pagination__link--active' : '' }}">{{ page }}</a>
                        </li>
                    {% endfor %}

                    <li class="sol-pagination__item">
                        {% if current_page < total_pages %}
                            <a href="{{ path('app_post_index', app.request.query.all|merge({'page': current_page + 1})) }}" class="sol-pagination__link">Next</a>
                        {% else %}
                            <span class="sol-pagination__link sol-pagination__link--disabled">Next</span>
                        {% endif %}
                    </li>
                </ul>
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}
