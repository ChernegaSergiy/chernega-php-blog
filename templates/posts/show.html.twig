{% extends 'base.html.twig' %}

{% set page_title = post.title %}
{% set meta_description = post.metaDescription %}

{% block meta %}
    <meta property="og:title" content="{{ post.metaTitle|default(post.title) }}">
    <meta property="og:description" content="{{ post.metaDescription }}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ canonical_url }}">
    {% if post.articleImage %}
        <meta property="og:image" content="{{ post.articleImage }}">
    {% endif %}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ post.metaTitle|default(post.title) }}">
    <meta name="twitter:description" content="{{ post.metaDescription }}">
    {% if post.articleImage %}
        <meta name="twitter:image" content="{{ post.articleImage }}">
    {% endif %}
{% endblock %}

{% block content %}
    <div class="sol-terminal sol-mb-lg">
        <span class="sol-prompt">blog view {{ post.slug }}</span>
    </div>

    <article class="sol-surface">
        {% if post.articleImage %}
            <img src="{{ post.articleImage }}" alt="{{ post.title }}" class="sol-w-full sol-mb-md">
        {% endif %}

        <div class="sol-mb-md">
            <h1>{{ post.title }}</h1>
            <div class="text-sm text-muted">
                <span>{{ post.createdAt|date('d.m.Y') }}</span> |
                <span>categories: 
                    {% for cat in post.categories %}
                        <a href="{{ path('app_post_index', {category: cat.name}) }}">{{ cat.name }}</a>{% if not loop.last %}, {% endif %}
                    {% endfor %}
                </span>
            </div>
        </div>

        <div class="post-content">
            {{ post.content|markdown_to_html|raw }}
        </div>
    </article>

    <div class="sol-text-center sol-mt-lg">
        <a href="{{ path('app_post_index') }}" class="sol-btn sol-btn--secondary sol-btn--outline">Повернутися до всіх постів</a>
    </div>
{% endblock %}
